# ============================================================
# Host reverse proxy (nginx) — routes both environments on one server.
#   tms.shreejamilk.com    -> production stack   (127.0.0.1:8080)
#   qatms.shreejamilk.com  -> QA / staging stack (127.0.0.1:8081)
#
# Install on the HOST (not in a container):
#   sudo apt install nginx
#   sudo cp deploy/reverse-proxy.conf.example /etc/nginx/sites-available/shreeja
#   sudo ln -s /etc/nginx/sites-available/shreeja /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# Then issue TLS certs for both hostnames:
#   sudo certbot --nginx -d tms.shreejamilk.com -d qatms.shreejamilk.com
# (certbot rewrites these blocks to listen on 443 and adds the cert paths.)
#
# DNS prerequisite: create an A record for qatms.shreejamilk.com pointing to
# this server's public IP (tms.shreejamilk.com already resolves here).
# ============================================================

# ---- Production ----
server {
    listen 80;
    server_name tms.shreejamilk.com;
    client_max_body_size 20M;

    location / {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}

# ---- QA / staging ----
server {
    listen 80;
    server_name qatms.shreejamilk.com;
    client_max_body_size 20M;

    location / {
        proxy_pass         http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
