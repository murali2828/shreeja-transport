# deploy/backup.env — settings for deploy/backup.sh and deploy/restore.sh
# Copy to deploy/backup.env, fill in, chmod 600. NEVER commit the filled file.
#
# Passphrase custody: generate with `openssl rand -base64 48`, put it in the IT
# vault (two named custodians) and one sealed envelope BEFORE the first run.
# A backup nobody can decrypt is worse than none.

# ── Tiers on this server ─────────────────────────────────────────────────────
# tier = <name>|<db container>|<uploads docker volume>|<repo dir>|<env file>
TIERS="prod|shreeja-db|shreeja-docuploads|$HOME/shreeja-transport|.env
qa|shreeja-qa-db|shreeja-qa-docuploads|$HOME/shreeja-qa|.env.qa"

# ── Local staging (on the server; mirrored to the NAS) ───────────────────────
BACKUP_DIR="$HOME/shreeja-backups"
KEEP_DAYS_DUMPS=14        # encrypted DB dumps
KEEP_DAYS_UPLOADS=7       # uploads archives (full copy each time; NAS snapshots keep history)
KEEP_DAYS_CONFIG=60       # encrypted config bundles
KEEP_DAYS_CODE=30         # git bundles

# ── Encryption ───────────────────────────────────────────────────────────────
# One passphrase for dumps and config bundles (openssl aes-256-cbc, pbkdf2).
BACKUP_PASSPHRASE="change_me_then_put_in_vault"

# ── NAS FTP mirror ───────────────────────────────────────────────────────────
# One FTP account per server; the NAS must keep daily snapshots (30 days) that
# this account cannot delete — that is the ransomware defence, not this script.
FTP_HOST="192.168.1.50"
FTP_PORT=21
FTP_USER="tms-backup"
FTP_PASS="change_me"
FTP_DIR="/tms-server"        # remote folder for this server; one sub-folder per tier is created
FTP_TLS=no                   # yes = explicit FTPS (set no if the NAS data channel fails, as on QNAP)

# ── Shrink guard ─────────────────────────────────────────────────────────────
# Refuse to mirror when the local set is smaller than the last mirrored set by
# more than this percent (protects the NAS copy from a wiped server).
GUARD_SHRINK_PCT=40

# ── Alerts (optional) — uses the mail command if present ────────────────────
ALERT_EMAIL_TO="murali.m@shreejamilk.com"
