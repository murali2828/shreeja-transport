# ===========================================================================
# ops-kit project identity — copy to <repo>/ops.env and COMMIT it (no secrets
# here; secrets live in .env.deploy). Every ops/bin script reads this first.
# Per-tier values use the prefix <TIER>_ in upper case (QA_HOST, PROD_HOST…);
# most have defaults derived from OPS_SLUG + the tier, listed in brackets.
# ===========================================================================

OPS_SLUG=myapp                 # short id → compose project "<slug>-<tier>", DB roles "<slug>_<tier>_user/app", tools image
OPS_LABEL="MyApp"              # prefix of every alert mail subject: [MyApp PROD] DOWN: db
OPS_TIERS="qa prod"            # tiers this repo deploys; each needs a compose file
OPS_KIT_DIR=ops                # where this kit lives inside the repo
OPS_TZ=Asia/Kolkata            # timezone for scratch restore clusters
#OPS_APP_DIR=/opt/myapp        # where the checkout lives on the server [repo root]
#OPS_BACKUP_DIR=/opt/myapp/backups   # [OPS_APP_DIR/backups]; .env.deploy BACKUP_DIR overrides

# --- services in the compose files -------------------------------------------
OPS_DB_SERVICE=postgres        # the Postgres service (built from ops/postgres — pgBackRest inside)
OPS_API_SERVICE=api            # the service that runs migrations / seeds / master exports
OPS_REDIS_SERVICE=redis        # set to "" (empty) if the stack has no Redis
OPS_SERVICES="postgres redis api web"     # everything that must be running (drop redis here too if OPS_REDIS_SERVICE is empty)
OPS_APP_SERVICES="api web"     # (re)started after migrations on deploy

# --- health endpoints (relative to https://<TIER>_HOST) ------------------------
OPS_HEALTH_PATH=/api/v1/health            # must return 200 + JSON carrying the running git sha
OPS_HEALTH_SHA_FIELD=data.git_sha         # dotted path to that sha inside the JSON
OPS_READY_PATH=/api/v1/health/ready       # "" to skip
OPS_BACKUP_HEALTH_PATH=/api/v1/health/backup   # "" to skip (ops/app/health.routes.snippet.js implements it)
OPS_WEB_PATH=/                            # "" to skip

# --- optional integrations ----------------------------------------------------
OPS_NGINX_SITE=myapp.conf                 # /etc/nginx/sites-available/<this>; "" = deploy does not touch nginx
OPS_NGINX_SRC=deploy/nginx-host.conf      # repo file copied there on every deploy
#OPS_CONFIG_EXTRA="gateway/.env services/*.json"   # extra non-git secret/config files for the encrypted config bundle
                                          # (every tier's *_ENV_FILE, all nginx sites, TLS, conf.d, docker daemon.json,
                                          #  crontab and ~/.ssh keys are always included — list only what is NOT)
OPS_HARDEN_SQL=ops/db/harden-privileges.sql   # "" = no restricted app role
OPS_VERIFY_SQL=ops/verify.sql             # printed after every restore; "" = generic per-table counts
OPS_MASTERS_CMD="npm run export:masters"  # the project's weekly master-data export (writes <BACKUP_DIR>/masters-<tier>/<date>/manifest.json); "" = none
OPS_MASTERS_CONTAINER_DIR=/app/backups/masters   # where the API container sees that directory
OPS_ESCROW=yes                            # credentials escrow expected (watchdog fails until sealed); "no" for a project with no external keys
OPS_CODE_REMOTE=git@github.com:org/repo.git    # documented in DR (the code bundle is the fallback)
#OPS_MOBILE_DIR=mobile                    # the Expo project directory (for the weekly EAS artefact download; needs EXPO_TOKEN in .env.deploy)
#OPS_UPLOADS_UID=1000                      # owner uid inside the API container for restored uploads

# --- per tier -----------------------------------------------------------------
QA_COMPOSE=docker-compose.qa.yml          # [docker-compose.<tier>.yml]
QA_PROJECT=myapp-qa                       # must equal `name:` in that compose file [<slug>-<tier>]
QA_BRANCH=qa                              # [qa → qa, prod → main]
QA_HOST=qa.myapp.example.com              # public hostname; "" = no public checks
QA_API_PORT=3002                          # host port the API publishes on 127.0.0.1; "" = skip local check
QA_ENV_FILE=backend/.env.qa               # the app's env file (goes into the encrypted config bundle)
QA_PGDATA_VOL=qa_pgdata                   # compose volume names WITHOUT the project prefix
QA_UPLOADS_VOL=qa_uploads                 # "none" if the app stores no files
QA_MIGRATE_CMD="npm run migrate"          # run in the API container as the OWNER role
QA_SEED_CMD="npm run seed:one --"         # a seed file name is appended
#QA_DB_USER=myapp_qa_user  QA_DB_NAME=myapp_qa_db  QA_DB_APP_USER=myapp_qa_app   [derived from OPS_SLUG]
#QA_DB_IMAGE=myapp-qa-postgres            [<project>-postgres]

PROD_COMPOSE=docker-compose.prod.yml
PROD_PROJECT=myapp-prod
PROD_BRANCH=main
PROD_HOST=myapp.example.com
PROD_API_PORT=3001
PROD_ENV_FILE=backend/.env.production
PROD_PGDATA_VOL=prod_pgdata
PROD_UPLOADS_VOL=prod_uploads
PROD_MIGRATE_CMD="npm run migrate:prod"
PROD_SEED_CMD="npm run seed:prod --"
