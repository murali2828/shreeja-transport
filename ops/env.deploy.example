# Host-side SECRETS for the ops-kit scripts. Copy to <repo>/.env.deploy
# (git-ignored) and chmod 600. Cron has no shell environment, so everything
# docker compose needs to interpolate the compose files must live here.
# Avoid single quotes (') in any value.

# --- per tier: database + redis (names match ops.env's <TIER>_DB_* defaults) --
QA_DB_USER=myapp_qa_user            # OWNER role: migrations / seeds / backups
QA_DB_PASS=change-me
QA_DB_NAME=myapp_qa_db
QA_DB_APP_USER=myapp_qa_app         # RUNTIME role (ops/db/harden-privileges.sql)
QA_DB_APP_PASS=change-me-too
QA_REDIS_PASS=change-me-redis

PROD_DB_USER=myapp_prod_user
PROD_DB_PASS=change-me
PROD_DB_NAME=myapp_prod_db
PROD_DB_APP_USER=myapp_prod_app
PROD_DB_APP_PASS=change-me-too
PROD_REDIS_PASS=change-me-redis

# --- backups (ops/docs/backup-restore.md, ops/docs/disaster-recovery.md) -------
BACKUP_DIR=/opt/myapp/backups
# NFS-mounted NAS share = pgBackRest repo2 + off-box copies under <NAS>/<hostname>/
BACKUP_NAS_DIR=/mnt/nas/myapp-backups
# ENCRYPTION AT REST — three passphrases (openssl rand -base64 32 each). Vault
# (two custodians) AND a sealed envelope. Never inside any backup or escrow.
BACKUP_CONFIG_PASSPHRASE=change-me-long-random       # config bundle
#BACKUP_DATA_PASSPHRASE=change-me-long-random-2      # dumps, master exports, escrow [defaults to the config passphrase]
BACKUP_REPO_CIPHER_PASS=change-me-long-random-3      # pgBackRest repository; then ONCE per tier: ops/bin/backup.sh <tier> encrypt-repo
# FTP/FTPS mirror (when the NAS offers only FTP) — everything in BACKUP_DIR
# under <BACKUP_FTP_DIR>/<hostname>/ nightly + every 4 h (up to 4 h behind).
#BACKUP_FTP_HOST=192.168.1.10
#BACKUP_FTP_PORT=21
#BACKUP_FTP_USER=backup_user
#BACKUP_FTP_PASS=change-me
#BACKUP_FTP_DIR=/
#BACKUP_FTP_TLS=auto          # auto | yes | no
# Optional second copy over ssh (another site / cloud VM)
#BACKUP_OFFSITE_RSYNC=backup@dr-host.example.com:/srv/myapp-backups
# Shrink guard (ops/docs/backup-restore.md §1d)
#BACKUP_GUARD_MAX_DROP=2      # backup sets that may disappear between two copies before the guard blocks
#BACKUP_OFFSITE_DELETE=yes    # no = never propagate deletions off-box
#BACKUP_PLAIN_REPO_KEEP_DAYS=28
#BACKUP_IMAGES=yes            # nightly docker save of the tier's images (~1–2 GB, 2 kept) — a rebuild then needs no Docker Hub / npm
#EXPO_TOKEN=change-me         # Expo personal access token → weekly download of the newest EAS build artefacts (mobile projects only)
#BACKUP_MAX_ARCHIVE_LAG_MIN=15
#BACKUP_MAX_AGE_HOURS=26

# --- e-mail alerts (ops/docs/monitoring-alerts.md) ----------------------------
ALERT_EMAIL_TO=it@example.com,owner@example.com
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=465
ALERT_SMTP_USER=noreply@example.com
ALERT_SMTP_PASS=change-me-app-password      # Google Workspace: an App Password, never the account password
#ALERT_SMTP_FROM=noreply@example.com
#ALERT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/.../messages?key=...
#ALERT_FAIL_THRESHOLD=2
#ALERT_REMIND_H=6
#ALERT_DISK_PCT=90
#ALERT_TLS_DAYS=14
#ALERT_DAILY_SUMMARY=true
