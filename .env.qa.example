# ============================================================
# Shreeja Transport — QA / staging environment variables
# Copy: cp .env.qa.example .env.qa   (NEVER commit .env.qa)
# Kept separate from production .env so QA can run on the same server.
# ============================================================

# Database (separate QA database + credentials)
DB_NAME=dairy_transport_qa
DB_USER=shreeja_db
DB_PASSWORD=choose_a_strong_qa_password_here

# JWT (use a DIFFERENT secret than production)
JWT_SECRET=change_this_to_a_separate_qa_random_string
JWT_EXPIRES_IN=8h

# Email — recommended: use a test inbox for QA so testing never mails real vendors
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.qa.email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=Shreeja QA <your.qa.email@gmail.com>

# Application
FRONTEND_URL=https://qatms.shreejamilk.com
NODE_ENV=production

# Road distance — a QA/test Google key is fine (or reuse prod key; caching keeps cost ~0)
GOOGLE_MAPS_API_KEY=
ROAD_DISTANCE_FACTOR=1.3

# Post-closure change approvals — login ID of the approving user (must exist with a valid email)
CHANGE_APPROVER_ID=PP01
# Comma-separated CC list for change-request approval emails
CHANGE_APPROVER_CC=billing1@shreejamilk.com,billing2@shreejamilk.com,rajesh.k@shreejamilk.com

# WheelsEye GPS tanker tracking (Live Tracking page + GPS column on Tanker Position)
# Access token issued by WheelsEye for the Shreeja account. Leave blank to disable
# the poller entirely. This is a live credential: keep it ONLY in the server's
# .env — never commit it, never paste it into code, tickets or chat.
WHEELSEYE_ACCESS_TOKEN=
# Poll interval in seconds (default 120, minimum 60)
WHEELSEYE_POLL_SECONDS=120
# true = also fetch the reverse-geocoded address (slower third-party lookup)
WHEELSEYE_FETCH_ADDRESS=false
# A position older than this many minutes is shown as "Stale"
WHEELSEYE_STALE_MINUTES=30
# Days of GPS trail history to keep (pruned hourly)
WHEELSEYE_HISTORY_DAYS=90
# Trip playback / analysis (Live Tracking → Trip mode, /api/tracking/trip/:id)
# A stop = consecutive GPS points within this radius (metres) while not moving
TRACKING_STOP_RADIUS_M=150
# Stops shorter than this many minutes are ignored
TRACKING_STOP_MIN_MINUTES=5
# A stop/point within this many metres of a planned BMCU / plant counts as "at" it
TRACKING_GEOFENCE_M=300

# Shreeja Assure integration API (read-only JSON feed at /api/integrations/assure/*,
# contract: docs/assure-handover/API_SPEC_v1.md). Leave both keys blank to keep the
# endpoints disabled (503 FEATURE_DISABLED). Generate a key: openssl rand -hex 32
# Live credential: keep it ONLY in the server's env file — never commit or paste it.
ASSURE_API_KEY=
# Rotation: set the new key here, hand it to Assure, then move it to ASSURE_API_KEY
# and clear this once Assure has switched (both are accepted while both are set).
ASSURE_API_KEY_NEXT=
# Optional comma-separated allow-list of caller IPs (Assure QA/production hosts).
# Blank = any IP that presents a valid key.
ASSURE_ALLOWED_IPS=
# Optional: git SHA reported by /ping as tms_version (falls back to package.json version).
TMS_GIT_SHA=

# ── Billing period settings ─────────────────────────────────────────────────
# Billing date = milk lifting date (plan_for_date) + this many days. The
# transport billing team bills on delivery date (lifting + 1), so a run for
# 1-15 of a month covers lifting dates from the last day of the previous
# month to the 14th. Set 1 on both tiers to match the team's tanker cards.
BILLING_DATE_OFFSET_DAYS=1
# Carry-forward never reaches earlier than this BILLING date (optional).
# Production, Sep 2026 parallel run with the billing team: 2026-09-01
BILLING_CARRY_FORWARD_FLOOR=

# ── Day Optimizer (fleet v2) — docs/OPTIMISATION_PLAN.md §3.2 ───────────────
# true = mount /api/optimize/day*, /prefetch-distances, /forecast/backfill and
# show "Day Optimizer" under Planning. On QA for UAT.
OPTIMIZER_V2_ENABLED=true
# Prefetch: Google-fetch every missing BMCU/plant pair whose straight-line
# distance is within this radius (km), at most this many calls per run.
OPTIMIZER_PREFETCH_RADIUS_KM=80
OPTIMIZER_PREFETCH_MAX=3000

# ── Billing module & approvals ──────────────────────────────────────────────
# true on QA so the billing module is available for UAT
BILLING_ENABLED=true
# Public base URL used in billing approval / vendor emails
APP_BASE_URL=https://qatms.shreejamilk.com
# Three-level billing approver emails (defaults are hardcoded in routes/billing.js; override here)
BILLING_APPROVER_1=
BILLING_APPROVER_2=
BILLING_APPROVER_3=
# Divert ALL billing emails (approvers + vendors) to one test inbox so UAT never mails real vendors
BILLING_EMAIL_REDIRECT=your.qa.email@gmail.com

# ── Runtime / database tuning (docker-compose sets the first four; override only for local dev) ──
PORT=5000
DB_HOST=db
DB_PORT=5432
# Document uploads directory inside the backend container (compose mounts a volume here)
UPLOAD_DIR=/app/uploads/documents
# TLS to Postgres: true only if the DB moves off the compose network
DB_SSL=false
# false = accept a self-signed DB certificate when DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Per-statement / per-query / idle-in-transaction timeouts in milliseconds
DB_STATEMENT_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=35000
DB_IDLE_TX_TIMEOUT_MS=300000

# ── One-off scripts ─────────────────────────────────────────────────────────
# backend/scripts/import_masters.js reads this Excel file (default /tmp/TMS_Master.xlsx)
EXCEL_PATH=
