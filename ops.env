# ===========================================================================
# Shreeja TMS — ops-kit identity (committed; NO secrets — those are in the
# git-ignored .env.deploy next to this file, template ops/env.deploy.example).
# QA and PROD run from separate checkouts on the same server
# (~/shreeja-qa on `qa`, ~/shreeja-transport on `main`); each checkout runs the
# ops scripts for its own tier, and both share one BACKUP_DIR.
# ===========================================================================

OPS_SLUG=shreeja-tms
OPS_LABEL="Shreeja TMS"
OPS_TIERS="qa prod"
OPS_KIT_DIR=ops
OPS_TZ=Asia/Kolkata

# --- services in the compose files --------------------------------------------
OPS_DB_SERVICE=db
OPS_API_SERVICE=backend
OPS_REDIS_SERVICE=
OPS_SERVICES="db backend frontend"
OPS_APP_SERVICES="backend frontend"

# --- health endpoints (backend/src/app.js) ---------------------------------------
OPS_HEALTH_PATH=/api/health
OPS_HEALTH_SHA_FIELD=git_sha
OPS_READY_PATH=/api/health/ready
OPS_BACKUP_HEALTH_PATH=/api/health/backup
OPS_WEB_PATH=/

# --- optional integrations ------------------------------------------------------
OPS_NGINX_SITE=                 # host nginx sites are maintained by hand (deploy/reverse-proxy.conf.example)
OPS_HARDEN_SQL=                 # phase 2: restricted app role — not yet
OPS_VERIFY_SQL=ops/verify.sql
OPS_MASTERS_CMD=
OPS_ESCROW=no                   # no mobile app / signing keys; API keys live in the env files (config bundle)
OPS_CODE_REMOTE=https://github.com/murali2828/shreeja-transport.git
OPS_UPLOADS_UID=1000            # node user inside the backend image

# --- QA (~/shreeja-qa, branch qa) -----------------------------------------------
QA_COMPOSE=docker-compose.qa.yml
QA_PROJECT=shreeja-qa
QA_BRANCH=qa
QA_HOST=qatms.shreejamilk.com
QA_API_PORT=8081
QA_ENV_FILE=.env.qa
QA_COMPOSE_ENV=".env.qa .env.deploy"
QA_PGDATA_VOL=qa-pgdata
QA_PGDATA_VOLUME=shreeja-qa-pgdata
QA_UPLOADS_VOL=qa-docuploads
QA_UPLOADS_VOLUME=shreeja-qa-docuploads
QA_DB_IMAGE=shreeja-qa-db
QA_DB_USER=shreeja_db          # must match DB_USER in .env.qa (password: QA_DB_PASS in .env.deploy)
QA_DB_NAME=dairy_transport_qa
QA_MIGRATE_CMD="node src/config/migrate.js"
QA_SEED_CMD="true"

# --- PROD (~/shreeja-transport, branch main) --------------------------------------
PROD_COMPOSE=docker-compose.yml
PROD_PROJECT=shreeja-transport
PROD_BRANCH=main
PROD_HOST=tms.shreejamilk.com
PROD_API_PORT=8080
PROD_ENV_FILE=.env
PROD_COMPOSE_ENV=".env .env.deploy"
PROD_PGDATA_VOL=pgdata
PROD_PGDATA_VOLUME=shreeja-pgdata
PROD_UPLOADS_VOL=docuploads
PROD_UPLOADS_VOLUME=shreeja-docuploads
PROD_DB_IMAGE=shreeja-transport-db
PROD_DB_USER=shreeja_db        # must match DB_USER in .env (password: PROD_DB_PASS in .env.deploy)
PROD_DB_NAME=dairy_transport
PROD_MIGRATE_CMD="node src/config/migrate.js"
PROD_SEED_CMD="true"
