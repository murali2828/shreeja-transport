# Shreeja TMS — host-side secrets for the ops-kit scripts (ops/bin/*).
# On the server: copy to .env.deploy in EACH checkout (~/shreeja-qa and
# ~/shreeja-transport — same content), then `chmod 600 .env.deploy`.
# Git-ignored. Avoid single quotes in values. Cron has no shell environment,
# so everything the scripts need is here.

# --- database passwords (the same values as DB_PASSWORD in .env.qa / .env) ----
QA_DB_PASS=change-me
PROD_DB_PASS=change-me

# --- where the other tier's env file lives (the config bundle carries both) ---
QA_ENV_FILE=/home/chaitanya/shreeja-qa/.env.qa
PROD_ENV_FILE=/home/chaitanya/shreeja-transport/.env

# --- backups ------------------------------------------------------------------
BACKUP_DIR=/home/chaitanya/tms-backups          # shared by both tiers; the compose files default to this path
# ENCRYPTION AT REST — generate each with: openssl rand -base64 48
# Put all three in the vault (two custodians) AND a sealed envelope BEFORE
# the first `backup.sh <tier> init`. Never inside any backup, chat or ticket.
BACKUP_CONFIG_PASSPHRASE=change-me-1     # config bundle (env files, nginx, TLS, crontab, ssh keys)
BACKUP_DATA_PASSPHRASE=change-me-2       # database dumps
BACKUP_REPO_CIPHER_PASS=change-me-3      # pgBackRest repository (point-in-time backups)

# FTP mirror to the NAS — everything in BACKUP_DIR under <BACKUP_FTP_DIR>/<hostname>/,
# nightly + every 4 hours (up to 4 hours behind).
BACKUP_FTP_HOST=192.168.x.x
BACKUP_FTP_PORT=21
BACKUP_FTP_USER=change-me
BACKUP_FTP_PASS=change-me
BACKUP_FTP_DIR=/tms-server-pitr       # new folder; the old deploy/backup.sh mirror (/tms-server) stays until switch-over
BACKUP_FTP_TLS=auto                      # set to no on a QNAP that refuses TLS
#BACKUP_GUARD_MAX_DROP=2
#BACKUP_IMAGES=yes

# --- e-mail alerts --------------------------------------------------------------
ALERT_EMAIL_TO=murali.m@shreejamilk.com,change-me-chaitanya@shreejamilk.com
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=465
ALERT_SMTP_USER=change-me@shreejamilk.com
ALERT_SMTP_PASS=change-me-app-password   # a Google Workspace App Password
#ALERT_SMTP_FROM=change-me@shreejamilk.com
