# ============================================================
# Shreeja Transport - Environment Variables
# Copy this file: cp .env.example .env
# Fill in your values. NEVER commit .env to GitHub.
# ============================================================

# Database
DB_NAME=dairy_transport
DB_USER=shreeja_db
DB_PASSWORD=choose_a_strong_password_here

# JWT - generate with: openssl rand -base64 32
JWT_SECRET=change_this_to_a_long_64_char_random_string
JWT_EXPIRES_IN=8h

# Email (Gmail SMTP)
# Gmail: Account -> Security -> 2FA -> App passwords -> Generate
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=Shreeja Transport <your.email@gmail.com>

# Application
FRONTEND_URL=http://YOUR_SERVER_IP
NODE_ENV=production

# Road distance (trip execution auto-calculation)
# Google Cloud API key with the "Routes API" enabled and billing active.
# Leave blank to fall back to the Haversine estimate (flagged as estimated).
GOOGLE_MAPS_API_KEY=
# Straight-line -> road multiplier used only for the Haversine fallback.
ROAD_DISTANCE_FACTOR=1.3

# Post-closure change approvals — login ID of the approving user (must exist with a valid email)
CHANGE_APPROVER_ID=PP01
# Comma-separated CC list for change-request approval emails
CHANGE_APPROVER_CC=billing1@shreejamilk.com,billing2@shreejamilk.com,rajesh.k@shreejamilk.com

# WheelsEye GPS tanker tracking (Live Tracking page + GPS column on Tanker Position)
# Access token issued by WheelsEye for the Shreeja account. Leave blank to disable
# the poller entirely. This is a live credential: keep it ONLY in the server's
# .env — never commit it, never paste it into code, tickets or chat.
WHEELSEYE_ACCESS_TOKEN=
# Poll interval in seconds (default 120, minimum 60)
WHEELSEYE_POLL_SECONDS=120
# true = also fetch the reverse-geocoded address (slower third-party lookup)
WHEELSEYE_FETCH_ADDRESS=false
# A position older than this many minutes is shown as "Stale"
WHEELSEYE_STALE_MINUTES=30
# Days of GPS trail history to keep (pruned hourly)
WHEELSEYE_HISTORY_DAYS=90
# Trip playback / analysis (Live Tracking → Trip mode, /api/tracking/trip/:id)
# A stop = consecutive GPS points within this radius (metres) while not moving
TRACKING_STOP_RADIUS_M=150
# Stops shorter than this many minutes are ignored
TRACKING_STOP_MIN_MINUTES=5
# A stop/point within this many metres of a planned BMCU / plant counts as "at" it
TRACKING_GEOFENCE_M=300
